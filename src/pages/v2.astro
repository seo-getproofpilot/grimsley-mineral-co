---
// ============================================================================
// V2 — THE HORIZON
//
// Information hierarchy: ONE THING AT A TIME, GETTING SMALLER.
// You land on the actual room at full height, floor to ceiling, boxes and all.
// Then one specimen alone at 620px. Then five at 180px. Then the lamp. Every
// object in the top half of the page stands on the SAME horizon line, and the
// room photograph's bottom edge is the first segment of that line, so the
// photograph and the objects are standing on one shelf rather than sitting in
// separate boxes. That shared line is what stops this reading as stacked
// sections, and it is the only structural device on the page.
//
// The scale drop from 620 to 180 is the argument: you are shown one thing,
// properly, and then told there is a lot more. Nothing here is a grid of equal
// cards, and there is no dark band anywhere. Black shows up exactly once, at
// the bottom of a photograph.
//
// All classes are g- prefixed. global.css owns .head, .card, .grid, .split,
// .btn, .stage and many other generic names.
// ============================================================================
import Base from "../layouts/Base.astro";
import ShelfWall from "../components/ShelfWall.astro";
import specimens from "../data/specimens.json";
import { u } from "../consts";

const bySlug = Object.fromEntries(specimens.map((s) => [s.slug, s]));

// The one object. Chosen for MASS, not for price: it is nearly square, so at
// 700px tall it is ~620px wide and actually occupies the stage. The vanadinite
// is brighter but it is a narrow 6cm miniature, and blown up alone it read as
// a small object marooned in a large column.
const hero = bySlug["cobaltoan-calcite"];
const lamp = bySlug["retro-rocket-lava-lamp"];

// The scale drop. Five pieces at a fraction of the hero's height, each still
// sized by what there is to look at rather than by price.
const row = [
  { slug: "vanadinite-mibladen", h: 215 },
  { slug: "rutile-stars-in-quartz", h: 150 },
  { slug: "citrine-heat-treated", h: 185 },
  { slug: "epidote-on-quartz", h: 120 },
  { slug: "muscovite-with-pyrite", h: 160 },
];

const mapDest = "5521%20South%20York%20Highway%2C%20Grimsley%2C%20TN%2038565";
---
<Base
  title="Minerals, Fossils &amp; Hand-Built Lava Lamps — Grimsley Mineral Co."
  description="One-of-one mineral and fossil specimens and hand-built lava lamps. Documented, measured, priced and shipped from Grimsley, Tennessee."
>
<div class="g2">

  <!-- THE ROOM -----------------------------------------------------------
       Full height. The photograph runs to the right edge of the viewport and
       down to the horizon line, which then continues left underneath the type
       and carries on through the next three sections. This is the whole
       collection in one frame: shelves, the lava lamp wall, and a few hundred
       pieces still laid out on the floor next to the boxes they came in. -->
  <div class="g-room">
    <div class="g-room-txt">
      <h1>Minerals, fossils and hand-built lava lamps.</h1>
      <p class="g-deck">Documented, measured, priced. Shipped from Grimsley, Tennessee.</p>
      <div class="g-acts">
        <a class="g-btn g-solid" href={u("minerals")}>See the minerals</a>
        <a class="g-btn g-quiet" href={u("lava-lamps")}>Into the Lava Lab</a>
      </div>
    </div>
    <figure class="g-room-pic">
      <img src={u("img/room/shelf-wall-wide-with-floor-layout.webp")} alt="The shelf wall packed with minerals and lava lamps, with pieces laid out across the wood floor in front of it and the boxes and bins they came out of" loading="eager" fetchpriority="high" decoding="async" />
    </figure>
    <p class="g-room-cap">The shelf wall, the floor in front of it, and the boxes it all came out of.</p>
  </div>

  <!-- ONE OBJECT ---------------------------------------------------------
       Standing on the same line the room photograph ends on. Label to the
       left, the way a museum labels a case, but set at reading size instead
       of as tracked capitals, because this is a workbench and not a vitrine. -->
  <div class="g-one">
    <div class="g-one-label">
      <h2>{hero.name}</h2>
      <dl>
        <div><dt>Size</dt><dd>{hero.sizeClass}, {hero.dimensions}</dd></div>
        <div><dt>Treatment</dt><dd>{hero.treatment}</dd></div>
        <div><dt>Condition</dt><dd>{hero.condition}</dd></div>
      </dl>
      <p class="g-price">${hero.price}</p>
      <a class="g-btn g-quiet" href={u(`specimen/${hero.slug}`)}>Look at this one properly</a>
      <!-- The scale reference. One huge object beside one small photograph of a
           different, much cheaper piece being held, which does more for scale
           than a ruler and is the only picture on the property with a person
           in it. Rule: one big object plus a small process photo, not three
           equal tiles. -->
      <figure class="g-hand">
        <img src={u("img/shelf/green-river-fish-plate-in-hand.webp")} alt="Two hands holding a Green River fossil fish plate, the fish visible in the tan limestone" loading="lazy" decoding="async" />
        <figcaption>A $30 fish plate, in hand. Photographs lie about size, so every piece carries its measurement.</figcaption>
      </figure>
    </div>
    <figure class="g-one-pic">
      <img src={u(hero.image)} alt={hero.name} loading="eager" decoding="async" />
    </figure>
  </div>

  <!-- FIVE MORE, MUCH SMALLER --------------------------------------------
       Same line, one third the height. The drop in scale is the point: you
       have been shown one thing properly, and now you are being told how much
       else is behind it. -->
  <div class="g-row">
    {row.map((slot) => {
      const s = bySlug[slot.slug];
      return (
        <a class="g-small" href={u(`specimen/${s.slug}`)} style={`--h:${slot.h}px`}>
          <span class="g-small-pic"><img src={u(s.image)} alt={s.name} loading="lazy" decoding="async" /></span>
          <span class="g-small-nm">{s.name}</span>
          <span class="g-small-dat">{s.dimensions}</span>
          <span class="g-small-fig">{s.status === "sold" ? "Sold" : `$${s.price}`}</span>
        </a>
      );
    })}
  </div>
  <div class="g-row-foot">
    <a class="g-btn g-quiet" href={u("minerals")}>See all of them</a>
    <a class="g-txtlink" href={u("fossils")}>Fossils and shells</a>
  </div>

  <!-- THE LAMP -----------------------------------------------------------
       One object again, mirrored, on its own horizon. Sitting where a
       specimen sat two screens ago is the argument that a homemade ray-gun
       lamp and a mineral belong to the same collection. -->
  <div class="g-lamp">
    <figure class="g-lamp-pic">
      <img src={u(lamp.image)} alt="A hand-sculpted rocket and ray-gun lava lamp with a blue flow, lit, on a granite counter" loading="lazy" decoding="async" />
    </figure>
    <div class="g-lamp-label">
      <h2>{lamp.name}</h2>
      <p>We collect lava lamps, fix them, change the wax and the fluid, and sometimes build one from the base up. This is one of those.</p>
      <dl>
        <div><dt>Size</dt><dd>{lamp.sizeClass}</dd></div>
        <div><dt>Condition</dt><dd>{lamp.condition}</dd></div>
        <div><dt>Reference</dt><dd>{lamp.ref}</dd></div>
      </dl>
      <p class="g-price">${lamp.price}</p>
      <div class="g-acts"><a class="g-btn g-quiet" href={u("lava-lamps")}>See the lamps</a></div>
    </div>
  </div>

  <!-- THE BREAK ----------------------------------------------------------
       A hard change of shape. After four sections of tall objects standing on
       a line, a wide flat letterbox stops the eye reading "another one of
       those" without needing a divider or a colour change. -->
  <figure class="g-break">
    <img src={u("img/nails/press-board.webp")} alt="Rows of hand-painted press-on nails on Taylor's pick and press board" loading="lazy" decoding="async" />
    <figcaption>Taylor's pick and press board.</figcaption>
  </figure>
  <div class="g-taylor">
    <h2>Taylor makes tiny things that get out of hand.</h2>
    <p>Custom press-ons, hand-painted and sculpted one nail at a time.</p>
    <div class="g-acts"><a class="g-btn g-quiet" href={u("nails")}>See what she makes</a></div>
  </div>

  <!-- THE WALL -----------------------------------------------------------
       Twelve, not eighteen. This page has spent its whole length showing one
       thing at a time, so the wall is here as a full stop rather than as a
       catalog. -->
  <div class="g-wall">
    <h2>In the room right now</h2>
    <ShelfWall limit={12} />
    <p class="g-note">Photographed where it sits. Nothing here is a stock image.</p>
  </div>

  <!-- STANDARD AND WHERE -------------------------------------------------
       Both on the same ground, side by side, so the page ends on one block
       instead of on two more stripes. -->
  <div class="g-end">
    <div class="g-standard">
      <h2>How we describe things</h2>
      <ul>
        <li><b>Treated says treated.</b> Heat-treated citrine gets labeled heat-treated citrine.</li>
        <li><b>Damage in writing.</b> Chips and repairs go in the listing, not in the box as a surprise.</li>
        <li><b>Size on every piece.</b> Measured and printed next to the name, every time.</li>
        <li><b>The photo is the piece.</b> Shot as it is. No flattering light, no borrowed stock.</li>
      </ul>
      <a class="g-txtlink" href={u("standard")}>Read the whole standard</a>
    </div>
    <div class="g-where">
      <h2>Grimsley, Tennessee</h2>
      <address>
        5521 South York Hwy<br />
        Grimsley, TN 38565<br />
        On US-127, between Dollar General and Taco Bros
      </address>
      <p>This is where the minerals, the lamps, the workbench and the photography all live. Not a storefront with posted hours.</p>
      <div class="g-acts">
        <a class="g-btn g-solid" href={u("contact")}>Get in touch</a>
        <a class="g-btn g-quiet" href={`https://www.google.com/maps/dir/?api=1&destination=${mapDest}`} target="_blank" rel="noopener">Get directions</a>
      </div>
      <div class="g-map">
        <iframe
          title="Map to 5521 South York Highway, Grimsley TN"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src="https://www.google.com/maps?q=5521+South+York+Highway,+Grimsley,+TN+38565&output=embed"
        ></iframe>
      </div>
    </div>
  </div>

</div>
</Base>

<style>
/* --------------------------------------------------------------------------
   V2 — a cooler, quieter paper than V1, because this page has far fewer
   things on it at any one moment and a warm ground would start to feel like
   a colour band. One ground throughout, no exceptions.
   -------------------------------------------------------------------------- */
.g2{
  --ground:#f2f2ee;
  --card:#fbfbf9;
  --ink:#1b1a17;
  --ink-2:#514f49;
  --dim:#8a8880;
  --hair:#d3d1c8;
  --hair-2:#b9b6aa;
  --brick:#9a4a33;
  --pad:clamp(20px,4vw,56px);
  --mw:1440px;
  --step:clamp(56px,7vw,112px);

  background:var(--ground);
  color:var(--ink);
  padding-bottom:clamp(48px,6vw,88px);
  overflow:clip;   /* contains the full-bleed horizon rules */
}
.g2 h1,.g2 h2{font-family:var(--serif);font-weight:400;font-synthesis-weight:none;letter-spacing:-.012em;margin:0;}
.g2 h1{font-size:clamp(30px,3.2vw,42px);line-height:1.12;max-width:15ch;}
.g2 h2{font-size:clamp(24px,2.5vw,32px);line-height:1.16;max-width:20ch;}
.g2 p{margin:0;}
.g2 figure{margin:0;}
.g2 .g-deck{margin-top:16px;max-width:38ch;font-size:16.5px;line-height:1.6;color:var(--ink-2);}

.g2 .g-acts{display:flex;gap:10px;flex-wrap:wrap;margin-top:26px;}
.g2 .g-btn{
  font-family:var(--sans);font-size:12px;letter-spacing:.13em;text-transform:uppercase;
  padding:14px 24px;border:1px solid transparent;display:inline-block;
  transition:background .16s,color .16s,border-color .16s;
}
.g2 .g-solid{background:var(--ink);color:var(--card);}
.g2 .g-solid:hover{background:#000;}
.g2 .g-quiet{color:var(--ink);border-color:var(--hair-2);}
.g2 .g-quiet:hover{border-color:var(--ink);background:rgba(0,0,0,.03);}
.g2 a:focus-visible{outline:2px solid var(--brick);outline-offset:3px;}
.g2 .g-txtlink{
  font-family:var(--sans);font-size:13px;color:var(--brick);
  border-bottom:1px solid currentColor;padding-bottom:2px;display:inline-block;
}
.g2 .g-txtlink:hover{color:var(--ink);}

/* The specimen label. A definition list at reading size, not tracked caps.
   A workshop labels things so they can be read, not so they look expensive. */
.g2 dl{margin:24px 0 0;display:grid;gap:0;max-width:40ch;}
.g2 dl > div{
  display:grid;grid-template-columns:104px 1fr;gap:14px;
  padding:9px 0;border-top:1px solid var(--hair);
}
.g2 dt{font-family:var(--mono);font-size:11px;letter-spacing:.06em;color:var(--dim);padding-top:2px;}
.g2 dd{margin:0;font-size:14.5px;line-height:1.5;color:var(--ink-2);}
.g2 .g-price{
  font-family:var(--mono);font-size:20px;color:var(--ink);
  margin-top:20px;padding-top:14px;border-top:1px solid var(--hair-2);max-width:40ch;
}

/* Two of the ten cutouts still carry a white plate behind them. Multiply
   drops it into the page ground instead of leaving a white rectangle. */
.g2 .g-one-pic img,.g2 .g-small-pic img{mix-blend-mode:multiply;}

/* THE ROOM ---------------------------------------------------------------
   Full-viewport grid rather than a centred container, so the photograph can
   reach the right edge of the screen while the type stays on exactly the
   same left rail as every section below it. */
.g2 .g-room{
  display:grid;grid-template-columns:42% 58%;align-items:center;
  min-height:min(86svh,880px);position:relative;
}
.g2 .g-room-txt{
  padding-left:max(var(--pad),calc((100vw - var(--mw)) / 2 + var(--pad)));
  padding-right:clamp(20px,3vw,48px);
  padding-block:clamp(36px,5vw,64px);
}
.g2 .g-room-pic{align-self:stretch;display:flex;}
.g2 .g-room-pic img{width:100%;height:100%;object-fit:cover;object-position:52% 42%;}
.g2 .g-room-cap{
  position:absolute;left:max(var(--pad),calc((100vw - var(--mw)) / 2 + var(--pad)));
  bottom:18px;font-family:var(--mono);font-size:11.5px;color:var(--dim);max-width:34ch;
}

/* THE SHARED HORIZON -----------------------------------------------------
   One hairline, drawn at the foot of the room photograph and again at the
   foot of every object below it. It spans the whole viewport, so it is the
   same shelf edge each time rather than a border on a box. */
.g2 .g-room::after,
.g2 .g-one::after,
.g2 .g-row::after,
.g2 .g-lamp::after{
  content:"";position:absolute;left:50%;transform:translateX(-50%);
  width:100vw;border-top:1px solid var(--hair-2);bottom:0;pointer-events:none;
}
.g2 .g-row::after{bottom:var(--tag);}

/* ONE OBJECT ------------------------------------------------------------- */
.g2 .g-one{
  position:relative;max-width:var(--mw);margin-inline:auto;
  padding:clamp(40px,5vw,80px) var(--pad) 0;
  display:grid;grid-template-columns:34fr 66fr;gap:clamp(24px,4vw,56px);
  align-items:end;
}
.g2 .g-one-label{padding-bottom:clamp(20px,3vw,44px);}
.g2 .g-hand{margin-top:clamp(28px,4vw,48px);max-width:400px;}
.g2 .g-hand img{width:100%;aspect-ratio:4/3;height:auto;object-fit:cover;object-position:50% 46%;}
.g2 .g-hand figcaption{
  font-family:var(--mono);font-size:11px;line-height:1.55;color:var(--dim);
  margin-top:10px;max-width:36ch;
}
.g2 .g-one-pic{display:flex;align-items:flex-end;justify-content:center;height:clamp(400px,58vw,700px);}
.g2 .g-one-pic img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;}

/* FIVE SMALL ------------------------------------------------------------- */
.g2 .g-row{
  /* --tag is the exact distance from the foot of an object to the foot of the
     section: pic margin 14 + name 38.4 + 5 + data 13 + 6 + figure 16 + 16.
     The horizon rule is drawn at that offset instead of at the section edge,
     so these five stand on a line the same way the big one above them does.
     .g-small-nm carries min-height:2.4em to keep it true when a name wraps. */
  --tag:108px;
  position:relative;max-width:var(--mw);margin-inline:auto;
  padding:var(--step) var(--pad) 0;
  display:grid;grid-template-columns:repeat(5,1fr);gap:clamp(14px,2vw,30px);
  align-items:end;
}
.g2 .g-small{display:flex;flex-direction:column;color:inherit;}
.g2 .g-small-pic{
  height:var(--h);display:flex;align-items:flex-end;justify-content:center;
  margin-bottom:14px;
}
.g2 .g-small-pic img{
  max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;
  transition:transform .35s ease;transform-origin:bottom center;
}
.g2 .g-small:hover .g-small-pic img{transform:translateY(-4px);}
.g2 .g-small-nm{
  font-family:var(--serif);font-size:16px;line-height:1.2;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.4em;
}
.g2 .g-small-dat{font-family:var(--mono);font-size:10.5px;color:var(--dim);margin-top:5px;}
.g2 .g-small-fig{font-family:var(--mono);font-size:12.5px;margin-top:6px;padding-bottom:16px;}
.g2 .g-row-foot{
  max-width:var(--mw);margin-inline:auto;padding:26px var(--pad) 0;
  display:flex;align-items:center;gap:26px;flex-wrap:wrap;
}

/* THE LAMP --------------------------------------------------------------- */
.g2 .g-lamp{
  position:relative;max-width:var(--mw);margin-inline:auto;
  padding:var(--step) var(--pad) 0;
  display:grid;grid-template-columns:56fr 44fr;gap:clamp(24px,4vw,56px);
  align-items:end;
}
.g2 .g-lamp-pic{display:flex;align-items:flex-end;justify-content:center;height:clamp(320px,42vw,520px);}
.g2 .g-lamp-pic img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;}
.g2 .g-lamp-label{padding-bottom:clamp(20px,3vw,44px);}
.g2 .g-lamp-label p{margin-top:16px;max-width:36ch;font-size:16px;line-height:1.6;color:var(--ink-2);}

/* THE BREAK -------------------------------------------------------------- */
.g2 .g-break{margin-top:var(--step);}
.g2 .g-break img{width:100%;aspect-ratio:1344/300;height:auto;object-fit:cover;object-position:50% 46%;}
.g2 .g-break figcaption{
  font-family:var(--mono);font-size:11.5px;color:var(--dim);
  max-width:var(--mw);margin:12px auto 0;padding:0 var(--pad);
}
.g2 .g-taylor{max-width:var(--mw);margin-inline:auto;padding:clamp(28px,4vw,52px) var(--pad) 0;}
.g2 .g-taylor p{margin-top:16px;max-width:40ch;font-size:16px;line-height:1.6;color:var(--ink-2);}

/* THE WALL --------------------------------------------------------------- */
.g2 .g-wall{max-width:var(--mw);margin-inline:auto;padding:var(--step) var(--pad) 0;}
.g2 .g-wall h2{margin-bottom:clamp(20px,3vw,32px);}
.g2 .g-wall :global(.shelfwall){gap:8px;}
.g2 .g-wall :global(.shelfwall figure){background:var(--card);}
.g2 .g-note{font-family:var(--mono);font-size:11.5px;color:var(--dim);margin-top:14px;}

/* END -------------------------------------------------------------------- */
.g2 .g-end{
  max-width:var(--mw);margin-inline:auto;padding:var(--step) var(--pad) 0;
  display:grid;grid-template-columns:46fr 54fr;gap:clamp(28px,5vw,72px);align-items:start;
}
.g2 .g-standard ul{list-style:none;margin:26px 0 26px;padding:0;max-width:44ch;}
.g2 .g-standard li{
  border-top:1px solid var(--hair);padding:14px 0;
  font-size:15px;line-height:1.6;color:var(--ink-2);
}
.g2 .g-standard b{font-family:var(--serif);font-weight:400;font-size:17px;color:var(--ink);}
.g2 .g-where address{
  font-style:normal;font-family:var(--mono);font-size:13.5px;line-height:1.85;
  color:var(--ink-2);margin-top:20px;
}
.g2 .g-where > p{margin-top:16px;max-width:40ch;font-size:15.5px;line-height:1.6;color:var(--ink-2);}
.g2 .g-map{margin-top:30px;aspect-ratio:16/9;background:var(--card);border:1px solid var(--hair);}
.g2 .g-map iframe{width:100%;height:100%;border:0;display:block;filter:saturate(.72);}

/* --------------------------------------------------------------------------
   Phone. The horizon survives: the room photo, the single object and the
   lamp all still stand on a full-width rule. Only the five-across row
   changes, to a scrollable strip, because five objects at 390px would be
   thumbnails and this page is about seeing one thing properly.
   -------------------------------------------------------------------------- */
@media (max-width:1000px){
  .g2 .g-room{grid-template-columns:1fr;min-height:0;}
  .g2 .g-room-txt{padding-left:var(--pad);padding-right:var(--pad);padding-block:clamp(28px,5vw,48px) 30px;}
  .g2 .g-room-pic{height:clamp(380px,72vw,560px);}
  .g2 .g-room-cap{position:static;padding:12px var(--pad) 0;max-width:none;}
  .g2 .g-one{grid-template-columns:1fr;gap:24px;align-items:start;}
  .g2 .g-one-pic{order:-1;height:clamp(320px,66vw,460px);padding-bottom:26px;}
  .g2 .g-one-label{padding-bottom:30px;}
  .g2 .g-lamp{grid-template-columns:1fr;gap:24px;}
  .g2 .g-lamp-pic{height:clamp(300px,64vw,440px);padding-bottom:26px;}
  .g2 .g-lamp-label{padding-bottom:30px;}
  .g2 .g-end{grid-template-columns:1fr;gap:44px;}
}
@media (max-width:760px){
  /* A horizontal strip instead of five squeezed columns. The objects stay at
     honest relative sizes and the shared baseline is kept. */
  .g2 .g-row{
    display:flex;gap:18px;overflow-x:auto;scrollbar-width:none;
    padding-bottom:0;scroll-snap-type:x proximity;
    /* Without this the first item's scroll-snap-align:start snaps to the
       container's snapport origin, which sits INSIDE the padding, so the
       strip silently self-scrolls by 20px on load and the first specimen
       loses its left margin. */
    scroll-padding-left:var(--pad);
  }
  /* The full-viewport horizon rule is absolutely positioned, so inside a
     horizontal scroller it would slide away with the content. */
  .g2 .g-row::after{display:none;}
  .g2 .g-row::-webkit-scrollbar{display:none;}
  .g2 .g-small{flex:0 0 46%;scroll-snap-align:start;}
  .g2 .g-small-pic{height:calc(var(--h) * .78);}
  .g2 .g-break img{aspect-ratio:16/9;}
  .g2 .g-one-label dl > div{grid-template-columns:88px 1fr;gap:10px;}
}
@media (prefers-reduced-motion:reduce){
  .g2 *{transition:none !important;}
}
</style>

<style is:global>
body:has(.g2){background:#f2f2ee;}
body:has(.g2) header.site{background:#f2f2ee;border-bottom-color:#d3d1c8;}
</style>
