---
import Base from "../layouts/Base.astro";
import { u } from "../consts";
import specimens from "../data/catalog";

// No gemstone has a record yet, so this page is deliberately a photograph and
// a short honest statement rather than a grid of placeholders.
//
// ONE photograph, and it is the parcel in the gem box, not the booth shelf. The
// parcel shot is the only image on the site showing actual faceted material,
// which is what someone on this page came to see. The booth-section shot is
// still the department tile on the homepage, so nothing is lost by leaving it
// off here, and it is one of the three pale-wall hot-pink-sign frames waiting on
// a reshoot.
//
// The caption gives colour and count and nothing else. The species and the carat
// weights of these stones have never been measured, so naming one would be
// inventing a fact. Every fact on
// it comes from what is visibly in the frame or from Marcos's own booth
// signage. Nothing here names a species, a carat weight or an origin, because
// none of that has been measured.
const items = specimens.filter((s) => s.line === "gemstones");
---
<Base
  title="Gemstones — Grimsley Mineral Co."
  description="Loose faceted stones, sold one at a time from the case in Grimsley, Tennessee. Measured and photographed before any of them get listed."
  active="gemstones"
>
  <div class="pagehead">
    <div class="inner">
      <div class="crumb"><a href={u("")}>Home</a> / Gemstones</div>
      <h1>Gemstones</h1>
      <p>Loose faceted stones, kept in the case and sold one at a time.</p>
    </div>
  </div>

  <section style="padding-top:0;">
    <div class="wrap">
      <div class="photopair one">
        <figure>
          <img src={u("img/gemstones/faceted-parcel-gem-box.webp")} alt="A white gem box held up to the light holding roughly a dozen faceted stones in pinks, purples and blues" width="1200" height="1600" loading="eager" decoding="async" />
        </figure>
      </div>
      <p class="cap-mono">Part of the parcel, held to the light. Nothing here has been weighed or identified yet.</p>
    </div>
  </section>

  {items.length > 0 && (
    <section style="padding-top:0;">
      <div class="wrap">
        <div class="grid">{items.map((item) => <a class="card" href={u(`specimen/${item.slug}`)}>{item.name}</a>)}</div>
      </div>
    </section>
  )}

  <section>
    <div class="wrap">
      <div class="sec-top">
        <div class="k">Why nothing is listed here yet</div>
        <h2>A stone gets a page when it has been measured.</h2>
      </div>
      <p style="max-width:56ch;font-size:var(--t-4);color:var(--ink-2);">
        Faceted stones need their own weight, dimensions and photograph before
        we will put a price next to one. That work is not done. The case is at
        the booth in the meantime, and everything in it is for sale there.
      </p>
      <div class="center-cta" style="text-align:left;">
        <a class="btn btn-gold" href={u("contact")}>Ask about a stone</a>
        <a class="btn btn-ghost" href={u("visit")}>Where we are</a>
      </div>
    </div>
  </section>
</Base>
