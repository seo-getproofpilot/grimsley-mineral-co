---
import Base from "../layouts/Base.astro";
import { u, SITE } from "../consts";
---
<Base
  title="Your Reserve List — Grimsley Mineral Co."
  description="The pieces you are holding. Send us the list and we come back with a shipping quote. Nothing is charged on this site."
  noindex={true}
  active=""
>
  <div class="pagehead">
    <div class="inner">
      <div class="crumb"><a href={u("")}>Home</a> / Reserve List</div>
      <h1>Your Reserve List</h1>
      <p>The pieces you are holding. Send the list and we set them aside under your name, then come back to you with a shipping quote to your address. Nothing is charged on this site. Payment is Square, Zelle, Cash App or cash.</p>
    </div>
  </div>

  <section>
    <div class="wrap">
      <div id="reserve-list" data-email={SITE.email}></div>
    </div>
  </section>
</Base>
