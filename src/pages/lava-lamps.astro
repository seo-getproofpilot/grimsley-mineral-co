---
import Base from "../layouts/Base.astro";
import { u } from "../consts";
import SpecimenCard from "../components/SpecimenCard.astro";
import specimens from "../data/catalog";
const lamps = specimens.filter((s) => s.line === "lava");
---
<Base
  title="Custom Hand-Built Lava Lamps — Grimsley Mineral Co."
  description="Hand-sculpted one-of-a-kind lava lamps built to order, alongside our collection of classic and vintage lamps. Commissions welcome."
  active="lava"
>
  <div class="pagehead">
    <div class="inner">
      <div class="crumb"><a href={u("")}>Home</a> / Lava Lab</div>
      <h1>Lava Lab</h1>
      <p>We collect them, fix them, change the wax and fluid, and sometimes completely rebuild them.</p>
    </div>
  </div>

  <div class="feature dark">
    <div class="split">
      <div class="txt">
        <div class="k">The craft</div>
        <h2>Sculpted one at a time.</h2>
        <p>Bases and caps get built by hand, painted, and paired with a working lava element. The ones we get wrong don't leave the room.</p>
      </div>
      <div class="pic"><img src={u("img/lifestyle/lava-collection.webp")} alt="Part of our lava lamp collection" width="1200" height="1600" decoding="async" /></div>
    </div>
  </div>

  {lamps.length > 0 && (
    <section>
      <div class="wrap">
        <div class="sec-top"><div class="k">Available now</div><h2>Finished pieces</h2></div>
        <div class="grid">{lamps.map((item) => <SpecimenCard item={item} />)}</div>
      </div>
    </section>
  )}

  <section class="trust">
    <div class="wrap">
      <div class="sec-top">
        <div class="k">Commissions</div>
        <h2>Want one built?</h2>
        <p>Tell us the theme and we'll tell you whether we can do it.</p>
      </div>
      <div class="center-cta"><a class="btn btn-dark" href={u("contact")}>Start a commission</a></div>
    </div>
  </section>
</Base>
