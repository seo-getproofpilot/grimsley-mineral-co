---
import Base from "../../layouts/Base.astro";
import { u } from "../../consts";
import articles from "../../data/articles.json";
---
<Base
  title="Guides — How to read a specimen — Grimsley Mineral Co."
  description="Plain-English guides to grading, localities, hardness, fluorescence and care. Reference material, separate from the dated journal."
  active="guides"
>
  <div class="pagehead">
    <div class="inner">
      <div class="crumb"><a href={u("")}>Home</a> / Guides</div>
      <h1>Guides</h1>
      <p>How to read a specimen, what makes one worth more than another, and how to keep what you collect from wrecking itself. Reference, written once and kept current. For what we are actually doing week to week, that is the <a href={u("journal")} style="color:var(--gold);">journal</a>.</p>
    </div>
  </div>
  <section>
    <div class="wrap">
      <div class="learn-grid">
        {articles.map((a, i) => (
          <a class="t" href={u(`field-notes/${a.slug}`)}>
            <div class="num">Guide 0{i + 1}</div>
            <h3>{a.title}</h3>
            <p>{a.excerpt}</p>
            <span class="r">Read →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
