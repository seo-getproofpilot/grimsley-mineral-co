---
// ============================================================================
// V3 — THE COLUMNS
//
// Information hierarchy: PLACE FIRST, THEN WHAT LIVES IN IT.
// Three tall photographs of the actual rooms and benches. Each one pins itself
// to the side of the screen and stays there while everything that lives in
// that room scrolls past it. The photograph does not scroll away, so an object
// is never presented on its own white void, it is presented next to the room
// it came out of.
//
// Structurally this is the opposite of a stack of bands: nothing on this page
// spans the full width except one photo mosaic near the end. The page is read
// in two vertical channels, and the channels swap sides three times, so there
// is no repeating horizontal rhythm for the eye to read as bricks.
//
// It is also the only one of the three that gives minerals, lava lamps and
// nails equal billing, which is the honest answer for someone arriving from a
// video of the three of them happening in the same house.
//
// All classes are g- prefixed. global.css owns .head, .card, .grid, .split,
// .btn, .pic, .txt and many other generic names.
// ============================================================================
import Base from "../layouts/Base.astro";
import ShelfWall from "../components/ShelfWall.astro";
import specimens from "../data/specimens.json";
import { u } from "../consts";

const bySlug = Object.fromEntries(specimens.map((s) => [s.slug, s]));

// Four pieces that scroll past the shelf wall. Deliberately spread across the
// whole price range, at unequal heights, so the column is never four of the
// same thing. The cheap tray of quartz gets a small frame and the vanadinite
// gets a large one, because that is what they are.
const passing = [
  { slug: "vanadinite-mibladen", h: 380 },
  { slug: "cobaltoan-calcite", h: 320 },
  { slug: "green-river-fish-plate", h: 260, crop: true },
  { slug: "quartz-cluster", h: 190, crop: true },
];

const lamp = bySlug["retro-rocket-lava-lamp"];

const mapDest = "5521%20South%20York%20Highway%2C%20Grimsley%2C%20TN%2038565";
---
<Base
  title="Minerals, Fossils &amp; Hand-Built Lava Lamps — Grimsley Mineral Co."
  description="One-of-one mineral and fossil specimens and hand-built lava lamps. Documented, measured, priced and shipped from Grimsley, Tennessee."
>
<div class="g3">

  <!-- COLUMN ONE — THE SHELF WALL ----------------------------------------
       Photo pinned left. The headline, then four pieces, go past it. The very
       first thing on the screen is a wall of the actual collection with the
       floor in front of it still covered in what has not been put away. -->
  <section class="g-col">
    <div class="g-col-pic">
      <figure>
        <img src={u("img/room/shelf-wall-wide-with-floor-layout.webp")} alt="The shelf wall packed with mineral specimens and lava lamps, with hundreds of pieces laid out across the wood floor in front of it beside the boxes and bins they came out of" loading="eager" fetchpriority="high" decoding="async" />
        <figcaption>The shelf wall, and the floor in front of it.</figcaption>
      </figure>
    </div>

    <div class="g-col-txt">
      <div class="g-intro">
        <h1>Minerals, fossils and hand-built lava lamps.</h1>
        <p class="g-deck">Documented, measured, priced. Shipped from Grimsley, Tennessee.</p>
        <div class="g-acts">
          <a class="g-btn g-solid" href={u("minerals")}>See the minerals</a>
          <a class="g-btn g-quiet" href={u("contact")}>Get in touch</a>
        </div>
      </div>

      <p class="g-lead">Some of what is on that wall, up close.</p>

      {passing.map((slot) => {
        const s = bySlug[slot.slug];
        return (
          <a class={`g-piece${slot.crop ? " g-piece-crop" : ""}`} href={u(`specimen/${s.slug}`)} style={`--h:${slot.h}px`}>
            <span class="g-piece-pic"><img src={u(s.image)} alt={s.name} loading="lazy" decoding="async" /></span>
            <span class="g-piece-lab">
              <span class="g-piece-nm">{s.name}</span>
              <span class="g-piece-dat">{s.sizeClass} · {s.dimensions}</span>
              <span class="g-piece-fig">${s.price}{s.priceNote ? ` ${s.priceNote}` : ""}</span>
            </span>
          </a>
        );
      })}

      <div class="g-more">
        <a class="g-btn g-quiet" href={u("minerals")}>All the minerals</a>
        <a class="g-txtlink" href={u("fossils")}>Fossils and shells</a>
      </div>
    </div>
  </section>

  <!-- COLUMN TWO — THE LAVA WALL -----------------------------------------
       Sides swap. Photo pinned right this time, so the page does not settle
       into a rhythm. -->
  <section class="g-col g-flip">
    <div class="g-col-pic">
      <figure>
        <img src={u("img/lifestyle/lava-collection.webp")} alt="A wall of lava lamps in different colors, lit, on shelves above the mineral cases" loading="lazy" decoding="async" />
        <figcaption>The lamp wall.</figcaption>
      </figure>
    </div>

    <div class="g-col-txt">
      <h2>The Lava Lab</h2>
      <p class="g-body">We collect lava lamps, fix them, change the wax and the fluid, and sometimes build one from the base up.</p>

      <a class="g-piece" href={u(`specimen/${lamp.slug}`)} style="--h:400px">
        <span class="g-piece-pic"><img src={u(lamp.image)} alt="A hand-sculpted rocket and ray-gun lava lamp with a blue flow, lit, on a granite counter" loading="lazy" decoding="async" /></span>
        <span class="g-piece-lab">
          <span class="g-piece-nm">{lamp.name}</span>
          <span class="g-piece-dat">{lamp.sizeClass} · {lamp.condition}</span>
          <span class="g-piece-fig">${lamp.price}</span>
        </span>
      </a>

      <div class="g-more">
        <a class="g-btn g-quiet" href={u("lava-lamps")}>See the lamps</a>
      </div>
    </div>
  </section>

  <!-- COLUMN THREE — THE NAIL BENCH --------------------------------------
       Back to the left. Taylor's work gets the same treatment as a $275
       mineral: a room photograph pinned beside it, at the same size. -->
  <section class="g-col">
    <div class="g-col-pic">
      <figure>
        <img src={u("img/nails/press-board.webp")} alt="Rows of hand-painted press-on nails laid out on Taylor's pick and press board" loading="lazy" decoding="async" />
        <figcaption>The pick and press board.</figcaption>
      </figure>
    </div>

    <div class="g-col-txt">
      <h2>Taylor makes tiny things that get out of hand.</h2>
      <p class="g-body">Custom press-ons, hand-painted and sculpted one nail at a time. Sets go out finished, sized and ready to press.</p>

      <div class="g-pair">
        <figure><img src={u("img/nails/set-red-checkerboard.webp")} alt="A finished set of red and black checkerboard press-on nails" loading="lazy" decoding="async" /></figure>
        <figure><img src={u("img/nails/set-blue-bows.webp")} alt="A finished set of pale blue press-on nails with sculpted bows" loading="lazy" decoding="async" /></figure>
      </div>

      <div class="g-more">
        <a class="g-btn g-quiet" href={u("nails")}>See what she makes</a>
      </div>
    </div>
  </section>

  <!-- THE MOSAIC ---------------------------------------------------------
       The one thing on this page that crosses both channels. After three
       sections of looking at a few things carefully, this is the volume. -->
  <section class="g-mosaic">
    <div class="g-mosaic-head">
      <h2>In the room right now</h2>
      <p>Photographed where it sits. Nothing here is a stock image.</p>
    </div>
    <ShelfWall limit={18} />
  </section>

  <!-- THE END ------------------------------------------------------------
       Two channels again, so the page finishes the way it started. -->
  <section class="g-col g-end">
    <div class="g-col-txt">
      <h2>How we describe things</h2>
      <ul class="g-rules">
        <li><b>Treated says treated.</b> Heat-treated citrine gets labeled heat-treated citrine.</li>
        <li><b>Damage in writing.</b> Chips and repairs go in the listing, not in the box as a surprise.</li>
        <li><b>Size on every piece.</b> Measured and printed next to the name, every time.</li>
        <li><b>The photo is the piece.</b> Shot as it is. No flattering light, no borrowed stock.</li>
      </ul>
      <a class="g-txtlink" href={u("standard")}>Read the whole standard</a>
    </div>

    <div class="g-col-txt">
      <h2>Grimsley, Tennessee</h2>
      <address>
        5521 South York Hwy<br />
        Grimsley, TN 38565<br />
        On US-127, between Dollar General and Taco Bros
      </address>
      <p class="g-body">This is where the minerals, the lamps, the workbench and the photography all live. Not a storefront with posted hours.</p>
      <div class="g-more">
        <a class="g-btn g-solid" href={u("contact")}>Get in touch</a>
        <a class="g-btn g-quiet" href={`https://www.google.com/maps/dir/?api=1&destination=${mapDest}`} target="_blank" rel="noopener">Get directions</a>
      </div>
      <div class="g-map">
        <iframe
          title="Map to 5521 South York Highway, Grimsley TN"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src="https://www.google.com/maps?q=5521+South+York+Highway,+Grimsley,+TN+38565&output=embed"
        ></iframe>
      </div>
    </div>
  </section>

</div>
</Base>

<style>
/* --------------------------------------------------------------------------
   V3 runs on near-white paper on purpose. Three enormous photographs are
   doing all the colour work on this page, and any tint in the ground would
   start competing with them. One ground, top to bottom, no bands.
   -------------------------------------------------------------------------- */
.g3{
  --ground:#faf8f4;
  --ink:#1a1815;
  --ink-2:#54514a;
  --dim:#8d897e;
  --hair:#ddd8cc;
  --hair-2:#c6c0b0;
  --bronze:#7a5c22;
  --pad:clamp(20px,4vw,56px);
  --mw:1440px;
  --step:clamp(64px,8vw,140px);
  /* The site header is sticky and roughly 151px tall at desktop widths, so a
     pinned column has to start below it or the top of the photograph sits
     behind an opaque bar. Measured, not guessed. */
  --stick:151px;

  background:var(--ground);
  color:var(--ink);
  padding-bottom:clamp(48px,6vw,88px);
}
.g3 h1,.g3 h2{font-family:var(--serif);font-weight:400;font-synthesis-weight:none;letter-spacing:-.012em;margin:0;}
.g3 h1{font-size:clamp(30px,3.4vw,44px);line-height:1.1;max-width:15ch;}
.g3 h2{font-size:clamp(23px,2.4vw,31px);line-height:1.16;max-width:19ch;}
.g3 p{margin:0;}
.g3 figure{margin:0;}
.g3 .g-deck{margin-top:16px;max-width:36ch;font-size:16.5px;line-height:1.6;color:var(--ink-2);}
.g3 .g-body{margin-top:16px;max-width:40ch;font-size:16px;line-height:1.62;color:var(--ink-2);}

.g3 .g-acts,.g3 .g-more{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:28px;}
.g3 .g-btn{
  font-family:var(--sans);font-size:12px;letter-spacing:.13em;text-transform:uppercase;
  padding:14px 24px;border:1px solid transparent;display:inline-block;
  transition:background .16s,color .16s,border-color .16s;
}
.g3 .g-solid{background:var(--ink);color:#fff;}
.g3 .g-solid:hover{background:#000;}
.g3 .g-quiet{color:var(--ink);border-color:var(--hair-2);}
.g3 .g-quiet:hover{border-color:var(--ink);background:rgba(0,0,0,.03);}
.g3 .g-txtlink{
  font-family:var(--sans);font-size:13px;color:var(--bronze);
  border-bottom:1px solid currentColor;padding-bottom:2px;display:inline-block;
}
.g3 .g-txtlink:hover{color:var(--ink);}
.g3 a:focus-visible{outline:2px solid var(--bronze);outline-offset:3px;}

/* THE TWO CHANNELS -------------------------------------------------------
   46/54, and the photo channel bleeds to the outer edge of the viewport
   while the text channel stays on the container rail. */
.g3 .g-col{
  display:grid;grid-template-columns:46% 54%;
  align-items:start;
  padding-top:var(--step);
}
.g3 .g-col:first-child{padding-top:0;}
.g3 .g-flip .g-col-pic{order:2;}
.g3 .g-flip .g-col-txt{order:1;}

.g3 .g-col-pic{
  position:sticky;top:calc(var(--stick) + 20px);
  height:calc(100svh - var(--stick) - 52px);
  display:flex;flex-direction:column;
}
.g3 .g-col-pic figure{display:flex;flex-direction:column;height:100%;min-height:0;}
.g3 .g-col-pic img{
  width:100%;flex:1 1 0;min-height:0;
  object-fit:cover;object-position:50% 45%;
}
.g3 .g-col-pic figcaption{
  font-family:var(--mono);font-size:11px;color:var(--dim);
  padding:10px var(--pad) 0;flex:0 0 auto;
}
/* No max-width on .g-col on purpose: the photo channel already starts at the
   outer edge of the viewport, and only the text channel is pulled back onto
   the container rail by its padding. That is what lets a photograph bleed off
   one side of the screen without any negative margins. */

.g3 .g-col-txt{
  padding-inline:clamp(24px,3.4vw,60px);
  padding-right:max(var(--pad),calc((100vw - var(--mw)) / 2 + var(--pad)));
}
.g3 .g-flip .g-col-txt{
  padding-left:max(var(--pad),calc((100vw - var(--mw)) / 2 + var(--pad)));
  padding-right:clamp(24px,3.4vw,60px);
}
.g3 .g-intro{padding-top:clamp(24px,4vw,56px);}
.g3 .g-lead{
  margin-top:clamp(56px,7vw,96px);padding-bottom:14px;border-bottom:1px solid var(--hair);
  font-family:var(--mono);font-size:11.5px;letter-spacing:.06em;color:var(--dim);
}

/* ONE PIECE GOING PAST ---------------------------------------------------
   Not a card. No border, no panel, no fixed aspect ratio. The photograph
   is whatever height it has been given and the label hangs under it. */
.g3 .g-piece{
  display:block;color:inherit;
  padding:clamp(34px,4vw,56px) 0 clamp(30px,3.5vw,48px);
  border-bottom:1px solid var(--hair);
}
.g3 .g-piece-pic{
  display:flex;align-items:flex-end;justify-content:flex-start;
  height:var(--h);
}
.g3 .g-piece-pic img{
  max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;
  /* Two of the ten cutouts still carry a white plate behind them instead of
     an alpha channel. Multiply drops the plate into the page ground. */
  mix-blend-mode:multiply;
  transition:transform .35s ease;transform-origin:bottom left;
}
.g3 .g-piece:hover .g-piece-pic img{transform:translateY(-5px);}
/* Photographs that are not cutouts get a real frame and no blend. */
.g3 .g-piece-crop .g-piece-pic{display:block;}
.g3 .g-piece-crop .g-piece-pic img{
  width:100%;height:var(--h);max-height:none;object-fit:cover;object-position:50% 48%;
  mix-blend-mode:normal;
}
.g3 .g-piece-lab{display:block;margin-top:20px;}
.g3 .g-piece-nm{display:block;font-family:var(--serif);font-size:clamp(19px,1.7vw,23px);line-height:1.2;}
.g3 .g-piece-dat{display:block;font-family:var(--mono);font-size:11px;color:var(--dim);margin-top:7px;}
.g3 .g-piece-fig{display:block;font-family:var(--mono);font-size:14px;margin-top:10px;}

/* Two finished sets side by side. The only place on the page where two
   images are the same size, and that is because they are the same thing. */
.g3 .g-pair{display:grid;grid-template-columns:1fr 1fr;gap:clamp(12px,1.6vw,22px);margin-top:clamp(34px,4vw,52px);}
.g3 .g-pair img{width:100%;aspect-ratio:3/4;height:auto;object-fit:cover;}

/* THE MOSAIC ------------------------------------------------------------- */
.g3 .g-mosaic{max-width:var(--mw);margin-inline:auto;padding:var(--step) var(--pad) 0;}
.g3 .g-mosaic-head{margin-bottom:clamp(22px,3vw,34px);}
.g3 .g-mosaic-head p{font-family:var(--mono);font-size:11.5px;color:var(--dim);margin-top:10px;}
.g3 .g-mosaic :global(.shelfwall){gap:8px;}

/* THE END ---------------------------------------------------------------- */
.g3 .g-end{grid-template-columns:46% 54%;align-items:start;}
.g3 .g-end .g-col-txt:first-child{
  padding-left:max(var(--pad),calc((100vw - var(--mw)) / 2 + var(--pad)));
  padding-right:clamp(24px,3.4vw,60px);
}
.g3 .g-rules{list-style:none;margin:26px 0 26px;padding:0;max-width:44ch;}
.g3 .g-rules li{border-top:1px solid var(--hair);padding:14px 0;font-size:15px;line-height:1.6;color:var(--ink-2);}
.g3 .g-rules b{font-family:var(--serif);font-weight:400;font-size:17px;color:var(--ink);}
.g3 address{font-style:normal;font-family:var(--mono);font-size:13.5px;line-height:1.85;color:var(--ink-2);margin-top:20px;}
.g3 .g-map{margin-top:30px;aspect-ratio:16/9;background:#fff;border:1px solid var(--hair);}
.g3 .g-map iframe{width:100%;height:100%;border:0;display:block;filter:saturate(.72);}

/* --------------------------------------------------------------------------
   Phone. Pinning a column beside another column needs two columns, and there
   is only one at 390px. So the photograph becomes a full-bleed panel that the
   section opens on, and the pieces run underneath it. The reading order is
   identical: room first, then what lives in it.
   -------------------------------------------------------------------------- */
@media (max-width:1000px){
  .g3 .g-col,.g3 .g-end{grid-template-columns:1fr;padding-top:clamp(48px,9vw,80px);}
  .g3 .g-flip .g-col-pic,.g3 .g-flip .g-col-txt{order:0;}
  .g3 .g-col-pic{
    position:static;height:auto;
    margin-bottom:clamp(28px,5vw,44px);
  }
  .g3 .g-col-pic figure{height:auto;}
  .g3 .g-col-pic img{height:clamp(400px,88vw,620px);flex:0 0 auto;width:100%;}
  .g3 .g-col-txt,
  .g3 .g-flip .g-col-txt,
  .g3 .g-end .g-col-txt:first-child{padding-inline:var(--pad);}
  .g3 .g-end .g-col-txt + .g-col-txt{margin-top:clamp(44px,8vw,64px);}
  .g3 .g-intro{padding-top:0;}
  .g3 .g-piece-pic{height:calc(var(--h) * .82);}
}
@media (prefers-reduced-motion:reduce){
  .g3 *{transition:none !important;}
}
</style>

<style is:global>
body:has(.g3){background:#faf8f4;}
body:has(.g3) header.site{background:#faf8f4;border-bottom-color:#ddd8cc;}
</style>
