---
import Base from "../layouts/Base.astro";
import SpecimenCard from "../components/SpecimenCard.astro";
import ShelfWall from "../components/ShelfWall.astro";
import specimens from "../data/catalog";
import { u } from "../consts";

const mapDest = "5521%20South%20York%20Highway%2C%20Grimsley%2C%20TN%2038565";

// ---------- DEPARTMENTS ----------
// The six departments, in merchandising order, each fronted by a photograph of
// the actual section of the room. The count under each name is read off the
// catalog, never typed in, so it can't drift out of date. Departments with
// nothing listed say where the pieces are instead of claiming a number, which
// is the honest version of "coming soon" and does not require a promise.
const count = (line: string) => specimens.filter((s) => s.line === line).length;
const DEPARTMENTS = [
  { href: "minerals",   img: "minerals",   name: "Minerals",         line: "minerals",
    alt: "The mineral table at the booth: dozens of specimens on black cloth with wooden risers, including spirit quartz, cobaltoan calcite, desert rose selenite and a pyrite sun" },
  { href: "fossils",    img: "fossils",    name: "Fossils",          line: "fossils",
    alt: "The fossil table on black cloth, with a hand-lettered Fossils sign on the wall behind it" },
  { href: "gemstones",  img: "gemstones",  name: "Gemstones",        line: "gemstones",
    alt: "A hand-lettered Gemstones sign above a shelf of gem boxes and loose stones, next to a shelf of UV reactive rocks" },
  { href: "lava-lamps", img: "lava-lamps", name: "Lava Lamps",       line: "lava", house: "lava",
    alt: "Three shelves of lava lamps in every colour, lit and running" },
  { href: "nails",      img: "nails",      name: "Nails",            line: "nails", house: "nails",
    alt: "Taylor's press-on nail display, with hand-lettered signs reading Find Your Size, Pick Your Case and Build Your Set" },
  { href: "currency",   img: "currency",   name: "Coins & Currency", line: "currency",
    alt: "A table of sleeved world banknotes laid out flat, with framed notes standing behind" },
];

// ---------- EXCEPTIONAL ----------
// Vault tier, straight from the catalog. These are the pieces that carry the
// room, so they get their own row above the general shop, not a badge inside it.
const exceptional = specimens.filter((s) => s.tier === "vault");

// ---------- UNDER $100 ----------
// A real shopping collection rather than a curated one: everything the catalog
// prices under a hundred dollars, most expensive first so the row opens strong.
const underHundred = specimens
  .filter((s) => typeof s.price === "number" && s.price < 100)
  .sort((a, b) => (b.price as number) - (a.price as number))
  .slice(0, 8);

// The hero photograph is the largest paint on the page, so it gets a frame cut
// for the shape it actually fills.
//
// What was here before: the cabinet-wall photo, a PORTRAIT 1200x1600 file, used
// as a cover background on a full-bleed LANDSCAPE band. Cover on a 2.4:1 band
// crops a portrait file to a narrow horizontal sliver, which is why the hero read
// as an extreme close-up with the cabinet grid invisible, a hand-lettered
// UV REACTIVE ROCKS starburst as the loudest thing on the page, and a hard
// vertical seam where the scrim ran out.
//
// These two are cut from the ORIGINAL 4284x5712 (IMG_4544, the black-table
// spread) at full resolution, one frame per shape. Black ground, real specimens,
// wood risers, and no signs or price tags anywhere in either frame.
const HERO_WIDE = "img/lifestyle/hero-table.webp";        // 2400x1000, >=761px
const HERO_TALL = "img/lifestyle/hero-table-mobile.webp"; // 1000x1250, phones
const heroCss =
  `.hero .bg{background-image:url("${u(HERO_TALL)}");background-position:center 44%;}` +
  `@media (min-width:761px){.hero .bg{background-image:url("${u(HERO_WIDE)}");` +
  `background-position:center 52%;}}`;
---
<Base
  title="Minerals, Fossils, Gemstones, Lava Lamps & Nails — Grimsley Mineral Co."
  description="Six departments in one room on US-127. Minerals, fossils, gemstones, hand-built lava lamps, hand-painted press-on nails and world currency, out of Grimsley, Tennessee."
  headCss={heroCss}
  preloadImage={[
    { file: HERO_TALL, media: "(max-width:760px)" },
    { file: HERO_WIDE, media: "(min-width:761px)" },
  ]}
>
  <!-- HERO
       One line, one photograph, two buttons. Every extra sentence here is the
       site explaining itself instead of showing you the room. -->
  <div class="hero">
    <div class="bg"></div>
    <div class="scrim"></div>
    <div class="inner">
      <div class="kicker">Grimsley, Tennessee</div>
      <h1 class="wide">Minerals, fossils, gemstones, lava lamps, nails and currency.</h1>
      <div class="btns">
        <a class="btn btn-gold" href="#departments">Shop the departments</a>
        <a class="btn btn-line" href={u("visit")}>Where we are</a>
      </div>
    </div>
  </div>

  <!-- DEPARTMENTS — the front door, and the first thing below the fold. -->
  <section id="departments">
    <div class="wrap">
      <div class="sec-top">
        <div class="k">The store</div>
        <h2>Six departments.</h2>
      </div>
      <div class="depts">
        {DEPARTMENTS.map((d) => {
          const n = count(d.line);
          return (
            <a class="dept" href={u(d.href)}>
              <img src={u(`img/departments/${d.img}.webp`)} alt={d.alt} width="1200" height="1600" loading="lazy" decoding="async" />
              <div class="cap">
                <div class="n">{d.name}</div>
                <div class="c">{n === 0 ? "At the booth" : n === 1 ? "1 listed, more at the booth" : `${n} listed`}</div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- EXCEPTIONAL — the best pieces, given room instead of a badge. -->
  <section style="padding-top:0;">
    <div class="wrap">
      <div class="sec-top">
        <div class="k">The best of it</div>
        <h2>Exceptional pieces</h2>
      </div>
      <div class="grid">
        {exceptional.map((item) => <SpecimenCard item={item} />)}
      </div>
    </div>
  </section>

  <!-- ONE OF ONE — the two departments where the piece is made, not found.
       Same treatment for both, deliberately. A $250 nail set gets the same
       block, the same photograph size and the same type as a rebuilt lamp. -->
  <div class="feature dark">
    <div class="split">
      <div class="txt">
        <div class="k">One of one</div>
        <h2>Lamps rebuilt from the base up.</h2>
        <p>We collect them, fix them, change the wax and the fluid, and sometimes build one that did not exist before.</p>
        <div class="btns"><a class="btn btn-gold" href={u("lava-lamps")}>See the lamps</a></div>
      </div>
      <div class="pic"><img src={u("img/lifestyle/lava-window.webp")} alt="Six lava lamps running in a windowsill in daylight" width="1200" height="1600" loading="lazy" decoding="async" /></div>
    </div>
  </div>

  <div class="feature quiet">
    <div class="split">
      <div class="pic"><img src={u("img/nails/press-board.webp")} alt="Rows of hand-painted press-on nails on Taylor's pick and press board" width="666" height="888" loading="lazy" decoding="async" /></div>
      <div class="txt">
        <div class="k">One of one</div>
        <h2>Sets painted one nail at a time.</h2>
        <p>Find your size, pick your case, build your set. Taylor sculpts and paints every one.</p>
        <div class="btns"><a class="btn btn-gold" href={u("nails")}>See what she makes</a></div>
      </div>
    </div>
  </div>

  <!-- UNDER $100 — a price shelf, because a store needs somewhere to start. -->
  <section>
    <div class="wrap">
      <div class="sec-top">
        <div class="k">Somewhere to start</div>
        <h2>Under $100</h2>
      </div>
      <div class="grid">
        {underHundred.map((item) => <SpecimenCard item={item} />)}
      </div>
      <div class="center-cta"><a class="btn btn-dark" href={u("minerals")}>See everything</a></div>
    </div>
  </section>

  <!-- THE SHELF
       Makes no claims, so it needs no facts checked. It is here purely to show
       the volume of real material before anyone reads another sentence. -->
  <section style="padding-top:0;">
    <div class="wrap">
      <div class="sec-top">
        <div class="k">Grimsley, Tennessee</div>
        <h2>In the room right now</h2>
      </div>
    </div>
    <div style="padding:0 8px;"><ShelfWall limit={18} /></div>
  </section>

  <!-- STANDARD — four promises, one line each. The long version has its own page. -->
  <section class="trust">
    <div class="wrap">
      <div class="sec-top"><div class="k">Our Standard</div><h2>How we describe things</h2></div>
      <div class="cols">
        <div class="c"><div class="n">Treated says treated</div><p>Heat-treated citrine gets labeled heat-treated citrine.</p></div>
        <div class="c"><div class="n">Damage in writing</div><p>Chips and repairs go in the listing, not in the box as a surprise.</p></div>
        <div class="c"><div class="n">Locality, or an admission</div><p>Down to the mine where we know it. A guess gets labeled a guess.</p></div>
        <div class="c"><div class="n">The photo is the piece</div><p>Shot as it is, with size on every listing. No flattering light.</p></div>
      </div>
      <div class="center-cta"><a class="btn btn-ghost" href={u("standard")}>Read the whole standard</a></div>
    </div>
  </section>

  <!-- WHERE WE ARE -->
  <div class="visit" id="visit">
    <div class="split">
      <div class="info">
        <div class="k">Where we are</div>
        <h2>Grimsley, Tennessee</h2>
        <div class="addr">
          5521 South York Hwy, Grimsley, TN 38565<br />
          On US-127, between Dollar General &amp; Taco Bros
        </div>
        <p style="color:var(--muted);font-size:15px;margin:18px 0 0;max-width:46ch;">This is where the collection, the lamps, the workbench and the photography all live. Not a storefront with posted hours.</p>
        <div class="btns">
          <a class="btn btn-gold" href={u("contact")}>Get in touch</a>
          <a class="btn btn-line" href={`https://www.google.com/maps/dir/?api=1&destination=${mapDest}`} target="_blank" rel="noopener">Get directions</a>
        </div>
      </div>
      <div class="mapbox live">
        <iframe
          title="Map to 5521 South York Highway, Grimsley TN"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src="https://www.google.com/maps?q=5521+South+York+Highway,+Grimsley,+TN+38565&output=embed"
        ></iframe>
      </div>
    </div>
  </div>
</Base>
