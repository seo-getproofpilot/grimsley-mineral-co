---
import Base from "../layouts/Base.astro";
import SpecimenCard from "../components/SpecimenCard.astro";
import Recent from "../components/Recent.astro";
import Workbench from "../components/Workbench.astro";
import ShelfWall from "../components/ShelfWall.astro";
import specimens from "../data/specimens.json";
import journal from "../data/journal.json";
import { u, statusOf } from "../consts";

const featuredMinerals = specimens.filter((s) => s.line === "minerals" && s.featured).slice(0, 6);
const collectionCount = specimens.filter((s) => !statusOf(s).sellable && s.status !== "sold").length;
const mapDest = "5521%20South%20York%20Highway%2C%20Grimsley%2C%20TN%2038565";

// The hero's first button points at the journal once there is a journal to
// point at, and at the catalog until then. A "see what we're working on" link
// into an empty page is a worse first impression than no link at all.
const hasJournal = (journal as any[]).length > 0;

// The hero photo is the largest paint on the page, so a phone should not be
// made to download the desktop file. Two sizes, picked by media query, and
// preloaded to match. Written here rather than in global.css because the URLs
// have to run through u() to survive the GitHub Pages base path.
const HERO_MOBILE = "img/lifestyle/cabinet-hero-mobile.webp";
const HERO_DESKTOP = "img/lifestyle/cabinet-hero.webp";
const heroCss =
  `.hero .bg{background-image:url("${u(HERO_MOBILE)}");background-position:center 30%;}` +
  `@media (min-width:900px){.hero .bg{background-image:url("${u(HERO_DESKTOP)}");}}`;
---
<Base
  title="Grimsley Mineral Co. — Minerals, Fossils & Lava Lamps"
  description="We collect minerals, fossils, old lava lamps and coins out of Grimsley, Tennessee. Some of it we sell, some of it we keep, and some we are still trying to identify."
  headCss={heroCss}
  preloadImage={[
    { file: HERO_MOBILE, media: "(max-width:899px)" },
    { file: HERO_DESKTOP, media: "(min-width:900px)" },
  ]}
>
  <!-- HERO
       One line. The photograph behind it is doing the explaining, and a
       paragraph here would only be describing what you can already see. -->
  <div class="hero">
    <div class="bg"></div>
    <div class="scrim"></div>
    <div class="inner">
      <div class="kicker">Grimsley, Tennessee</div>
      <h1>We collect weird stuff.</h1>
      <p>Some of it is for sale. Some of it isn't going anywhere.</p>
      <div class="btns">
        {hasJournal
          ? <a class="btn btn-gold" href={u("journal")}>See what we're working on</a>
          : <a class="btn btn-gold" href={u("minerals")}>Browse the minerals</a>}
        <a class="btn btn-line" href={u("lava-lamps")}>Into the Lava Lab</a>
      </div>
    </div>
  </div>

  <Workbench />
  <Recent limit={3} />

  <!-- LAVA — leads the categories because it is the most unusual thing we do. -->
  <div class="feature dark" id="lava" data-line="lava">
    <div class="split">
      <div class="txt">
        <div class="k">The Lava Lab</div>
        <h2>Lava lamps.</h2>
        <p>We collect them, fix them, change the wax and fluid, and sometimes rebuild one from the base up.</p>
        <div class="btns"><a class="btn btn-gold" href={u("lava-lamps")}>See the lamps</a></div>
      </div>
      <div class="pic"><img src={u("img/lifestyle/lava-collection.webp")} alt="Part of our lava lamp collection, lit" width="1200" height="1600" loading="lazy" decoding="async" /></div>
    </div>
  </div>

  <!-- MINERALS — the specimen photos are the section. -->
  <section>
    <div class="wrap">
      <div class="sec-top">
        <div class="k">Minerals</div>
        <h2>Minerals</h2>
        <p>Some are for sale. Some aren't going anywhere.</p>
      </div>
      <div class="grid">
        {featuredMinerals.map((item) => <SpecimenCard item={item} />)}
      </div>
      <div class="center-cta"><a class="btn btn-dark" href={u("minerals")}>See all of them</a></div>
    </div>
  </section>

  <!-- NAILS -->
  <div class="feature pink" id="nails" data-line="nails">
    <div class="split">
      <div class="pic"><img src={u("img/nails/press-board.webp")} alt="Rows of hand-painted press-on nails on Taylor's pick and press board" width="666" height="888" loading="lazy" decoding="async" /></div>
      <div class="txt">
        <div class="k">Bugged Out Nails</div>
        <h2>Taylor makes tiny things that get out of hand.</h2>
        <p>Custom press-ons, hand-painted and sculpted one nail at a time.</p>
        <div class="btns"><a class="btn btn-pink" href={u("nails")}>See what she makes</a></div>
      </div>
    </div>
  </div>

  <!-- SECONDARY LINES
       Was three text-only cards asking you to read a taxonomy. Now each one
       leads with a photograph of the actual thing, because that is what both
       Arkenstone and FossilEra do and it is the difference between a category
       list and visible inventory. -->
  <section style="padding-top:0;">
    <div class="wrap">
      <div class="sec-top">
        <div class="k">Also on the shelf</div>
        <h2>The rest of it</h2>
      </div>
      <!-- Coins is deliberately not a tile. There are no coins in the catalog
           yet and no photograph of one, so a tile here would be a picture of
           minerals under a coins label. It stays in the nav until there is
           something real to show. -->
      <div class="cats">
        <a class="cattile" href={u("fossils")}>
          <img src={u("img/shelf/green-river-fish-plate-in-hand.webp")} alt="A Green River fish fossil plate held in one hand" style="object-position:50% 62%;" loading="lazy" decoding="async" />
          <div class="cap"><div class="p">Fossils &amp; Shells</div><div class="l">Fish plates, coral, shark teeth, pearls.</div><div class="g">See the fossils →</div></div>
        </a>
        <a class="cattile" href={u("localities")}>
          <img src={u("img/shelf/vanadinite-and-quartz-calcite.webp")} alt="Orange vanadinite crystals beside quartz and calcite" loading="lazy" decoding="async" />
          <div class="cap"><div class="p">Localities</div><div class="l">Where these came from, mine by mine.</div><div class="g">Browse by place →</div></div>
        </a>
        <a class="cattile" href={u(collectionCount > 0 ? "collection" : "about")}>
          <img src={u("img/room/built-in-niche-wall-early.webp")} alt="The built-in lit niche holding minerals and vintage lava lamps" style="object-position:50% 40%;" loading="lazy" decoding="async" />
          {collectionCount > 0
            ? <div class="cap"><div class="p">The Collection</div><div class="l">Ours, and staying ours.</div><div class="g">Not for sale →</div></div>
            : <div class="cap"><div class="p">The Room</div><div class="l">Where all of it actually lives.</div><div class="g">About us →</div></div>}
        </a>
      </div>
    </div>
  </section>

  <!-- THE SHELF
       Makes no claims, so it needs no facts checked. It is here purely to
       show the volume of real material before anyone reads another sentence. -->
  <section style="padding-top:0;">
    <div class="wrap">
      <div class="sec-top">
        <div class="k">Grimsley, Tennessee</div>
        <h2>What's actually here</h2>
      </div>
    </div>
    <div style="padding:0 8px;"><ShelfWall limit={18} /></div>
  </section>

  <!-- STANDARD — four promises, one line each. The long version has its own page. -->
  <section class="trust">
    <div class="wrap">
      <div class="sec-top"><div class="k">Our Standard</div><h2>How we describe things</h2></div>
      <div class="cols">
        <div class="c"><div class="n"><span class="b"></span>Treated says treated</div><p>Heat-treated citrine gets labeled heat-treated citrine.</p></div>
        <div class="c"><div class="n"><span class="b"></span>Damage in writing</div><p>Chips and repairs go in the listing, not in the box as a surprise.</p></div>
        <div class="c"><div class="n"><span class="b"></span>Locality, or an admission</div><p>Down to the mine where we know it. A guess gets labeled a guess.</p></div>
        <div class="c"><div class="n"><span class="b"></span>The photo is the piece</div><p>Shot as it is, with size on every listing. No flattering light.</p></div>
      </div>
      <div class="center-cta"><a class="btn btn-ghost" href={u("standard")}>Read the whole standard</a></div>
    </div>
  </section>

  <!-- WHERE WE ARE -->
  <div class="visit" id="visit">
    <div class="split">
      <div class="info">
        <div class="k">Where we are</div>
        <h2>Grimsley, Tennessee</h2>
        <div class="addr">
          5521 South York Hwy, Grimsley, TN 38565<br />
          On US-127, between Dollar General &amp; Taco Bros
        </div>
        <p style="color:var(--muted);font-size:15px;margin:18px 0 0;max-width:46ch;">This is where the collection, the lamps, the workbench and the photography all live. Not a storefront with posted hours.</p>
        <div class="btns">
          <a class="btn btn-gold" href={u("contact")}>Get in touch</a>
          <a class="btn btn-line" href={`https://www.google.com/maps/dir/?api=1&destination=${mapDest}`} target="_blank" rel="noopener">Get directions</a>
        </div>
      </div>
      <div class="mapbox live">
        <iframe
          title="Map to 5521 South York Highway, Grimsley TN"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src="https://www.google.com/maps?q=5521+South+York+Highway,+Grimsley,+TN+38565&output=embed"
        ></iframe>
      </div>
    </div>
  </div>
</Base>
