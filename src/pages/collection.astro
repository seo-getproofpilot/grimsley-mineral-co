---
import Base from "../layouts/Base.astro";
import SpecimenCard from "../components/SpecimenCard.astro";
import { u, SPECIMEN_STATUS, statusOf } from "../consts";
import specimens from "../data/specimens.json";

// Everything that has a page but no price. A retail site assumes that if a
// thing is published it is for sale; this page exists because that assumption
// is too small for what this actually is.
const GROUPS = ["collection", "researching", "coming_soon"];
const grouped = GROUPS.map((key) => ({
  key,
  meta: SPECIMEN_STATUS[key],
  items: specimens.filter((s) => s.status === key),
})).filter((g) => g.items.length > 0);

const total = grouped.reduce((n, g) => n + g.items.length, 0);
const empty = total === 0;
---
<Base
  title="The Collection — Pieces we're keeping — Grimsley Mineral Co."
  description="The specimens that are ours and staying ours, and the ones we have not finished identifying. Published because they are worth looking at, not because they are for sale."
  active="collection"
  noindex={empty}
>
  <div class="pagehead">
    <div class="inner">
      <div class="crumb"><a href={u("")}>Home</a> / Collection</div>
      <h1>The Collection</h1>
      <p>Not everything here is for sale. Some pieces are ours and are staying ours. Some we are still working out, and we will not put a price on something we cannot describe honestly yet. They get a page anyway, because a thing being interesting has nothing to do with whether we are selling it.</p>
    </div>
  </div>

  {empty ? (
    <section>
      <div class="wrap">
        <div class="emptyjournal">
          <h2>Nothing marked yet.</h2>
          <p>Every piece cataloged so far is available or sold. As we set pieces aside to keep, or pick up something we cannot identify, they show up here.</p>
          <a class="btn btn-dark" href={u("minerals")}>See what is for sale</a>
        </div>
      </div>
    </section>
  ) : (
    grouped.map((g) => (
      <section>
        <div class="wrap">
          <div class="sec-top">
            <div class="k">{g.meta.label}</div>
            <h2>{g.items.length} {g.items.length === 1 ? "piece" : "pieces"}</h2>
            <p>{g.meta.note}</p>
          </div>
          <div class="grid">{g.items.map((item) => <SpecimenCard item={item} />)}</div>
        </div>
      </section>
    ))
  )}

  {!empty && (
    <section class="trust" style="padding-top:0;">
      <div class="wrap">
        <div class="emptyjournal">
          <h2>Think you know what one of these is?</h2>
          <p>The pieces marked still researching are genuinely unidentified. If you recognize something, we want to hear it, and we will say where the answer came from when we update the page.</p>
          <a class="btn btn-dark" href={u("contact")}>Tell us what we're looking at</a>
        </div>
      </div>
    </section>
  )}
</Base>
