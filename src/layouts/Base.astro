---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, FULL_ADDRESS, u } from "../consts";

// Booth-sale window. Rendered from the build date so the page is correct with
// JavaScript off, then corrected in the browser by the inline script below.
// Without that correction a static site with no deploy after Aug 9 would go on
// advertising a discount that has ended.
const today = new Date().toISOString().slice(0, 10);
const boothPhase =
  today > SITE.event.endDate ? "" : today < SITE.event.startDate ? "before" : "live";

const {
  title = "Grimsley Mineral Co.",
  description = "Minerals, fossils and hand-built lava lamps out of Grimsley, Tennessee. Documented, measured and priced.",
  active = "",
  // Per-page structured data (an object or array of objects). Rendered as
  // JSON-LD alongside the site-wide LocalBusiness graph below.
  schema = null,
  // The page's largest above-the-fold image, relative to /public. Pass this on
  // any page whose hero is a CSS background-image: the browser can't find those
  // until it has parsed the CSS, which delays the largest paint. Preloading
  // hands it to the network straight away.
  // Either a string, or [{ file, media }] when the hero is served at more than
  // one size — the media attribute keeps a phone from fetching the desktop file.
  preloadImage = null,
  // Extra CSS for this page, injected into <head>. For rules whose URLs must
  // run through u() and therefore cannot live in a static stylesheet.
  headCss = null,
  // Keep a page out of the index. Used only for pages whose content is
  // per-visitor and therefore useless in search results.
  noindex = false,
} = Astro.props;

// There is one brand palette. There used to be a per-department "house" here
// that recoloured the whole document for /lava-lamps and /nails, which is the
// fragmentation Marcos rejected: the brand level is unified, the department
// level specializes through photography and field sets, never brand colour.
// See "ONE BRAND, ONE PALETTE" in global.css before adding anything like it back.

// Canonical + OG url resolve against the configured `site` in astro.config.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(u("img/lifestyle/hero.jpg"), Astro.site).href;

// Site-wide LocalBusiness. This is what Google reads for the map pack / rich
// results and what AI answer engines cite for "who/where/when".
const localBusiness = {
  "@context": "https://schema.org",
  "@type": "Store",
  "name": SITE.name,
  "description": SITE.tagline,
  "url": SITE.url,
  "email": SITE.email,
  "image": ogImage,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": SITE.address.street,
    "addressLocality": SITE.address.city,
    "addressRegion": SITE.address.state,
    "postalCode": SITE.address.zip,
    "addressCountry": "US",
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": SITE.address.lat,
    "longitude": SITE.address.lng,
  },
  // sameAs tells Google these profiles ARE this business, so an unconfirmed URL
  // here is worse than a missing one. Nulls are dropped rather than published.
  "sameAs": [SITE.social.instagram, SITE.social.facebook].filter(Boolean),
};

const pageSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

// Fonts. Declared here rather than in global.css so the URLs are stable and
// preloadable. `block` (not `swap`) on the two faces used above the fold:
// they are preloaded, so they arrive with the stylesheet and the brief block
// costs nothing, where a swap would visibly reflow the headline.
// Archivo is a variable font, so one file covers 100-900 and the weight
// descriptor is a range, not a number. Instrument Serif ships a single
// weight on purpose. Plex Mono is static and only carries specimen data,
// so it never needs to block.
const FONTS = [
  { family: "Instrument Serif", weight: "400", file: "fonts/instrument-400.woff2", preload: true },
  { family: "Archivo", weight: "100 900", file: "fonts/archivo-var.woff2", preload: true },
  { family: "IBM Plex Mono", weight: "400", file: "fonts/plexmono-400.woff2", preload: false },
  { family: "IBM Plex Mono", weight: "500", file: "fonts/plexmono-500.woff2", preload: false },
];
const fontCss = FONTS.map(
  (f) =>
    `@font-face{font-family:"${f.family}";font-weight:${f.weight};font-style:normal;` +
    `font-display:${f.preload ? "block" : "swap"};src:url("${u(f.file)}") format("woff2");}`
).join("");
---
<!doctype html>
<html lang="en" data-base={import.meta.env.BASE_URL} data-booth={boothPhase || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script is:inline set:html={`(function(){var s=${JSON.stringify(SITE.event.startDate)},e=${JSON.stringify(SITE.event.endDate)},d=new Date(),p=function(n){return(n<10?'0':'')+n},t=d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate()),r=document.documentElement;if(t>e){r.removeAttribute('data-booth')}else{r.setAttribute('data-booth',t<s?'before':'live')}})();`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    {FONTS.filter((f) => f.preload).map((f) => (
      <link rel="preload" as="font" type="font/woff2" href={u(f.file)} crossorigin />
    ))}
    <style is:global set:html={fontCss} />

    {preloadImage &&
      (Array.isArray(preloadImage) ? preloadImage : [{ file: preloadImage }]).map((p) => (
        <link rel="preload" as="image" href={u(p.file)} media={p.media} fetchpriority="high" />
      ))}
    {headCss && <style is:global set:html={headCss} />}

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🪨</text></svg>" />

    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    {pageSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <Header active={active} />
    <main>
      <slot />
    </main>
    <Footer />
    <script src={u("js/reserve.js")}></script>
    <script src={u("js/subscribe.js")}></script>
  </body>
</html>
