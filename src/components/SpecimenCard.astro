---
import { u, CARE_LABELS, statusOf, showsPrice } from "../consts";
const { item } = Astro.props;
const st = statusOf(item);
const showBadge = item.status !== "available";
const priced = showsPrice(item);
const care = item.care || [];
// `soldout` is the existing class that hides booth pricing and dims the card.
// Everything that is not for sale wants that same treatment, not just sold.
const inert = !st.sellable;
---
<a class={`card${inert ? " soldout" : ""}`} href={u(`specimen/${item.slug}`)} data-size={item.sizeClass} data-price={item.price} data-species={item.species} data-locality={item.locality} data-tier={item.tier} data-status={item.status}>
  <div class="imgwrap">
    {showBadge && <span class={`badge ${item.status}`}>{st.label}</span>}
    <img src={u(item.image)} alt={item.name} loading="lazy" />
  </div>
  <div class="meta">
    <div class="sp">{item.name}</div>
    <div class="loc">{item.locality}</div>
    {item.provenance && <div class="prov">{item.provenance}</div>}
    {care.length > 0 && (
      <div class="flags">
        {care.map((c) => <span class="flag">{CARE_LABELS[c] || c}</span>)}
      </div>
    )}
    <div class="dims">{item.sizeClass} · {item.dimensions}</div>
    <div class="row">
      {priced ? (
        <span class="price"><span class="cur">$</span>{item.price}.00{item.priceNote && <span class="pn"> {item.priceNote}</span>}</span>
      ) : (
        <span class="statusline">{st.label}</span>
      )}
    </div>
  </div>
</a>
