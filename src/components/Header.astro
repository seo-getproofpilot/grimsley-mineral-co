---
import { u } from "../consts";
const { active = "" } = Astro.props;

// Six items. The nav is not the sitemap — it does not have to expose our
// internal taxonomy. Minerals stands in for the shop because minerals are
// overwhelmingly what sells. Fossils, Coins, Localities, Sold and Our
// Standard all still exist, still get linked from the footer and from the
// pages they belong to, and don't need to compete here.
// `line` is which house the item belongs to. It colours the item's own rule,
// so the navigation itself shows you that Lava Lab and Taylor's Nails are
// different rooms in the same building. Items with no line inherit whatever
// the page is set to.
const nav = [
  { href: "minerals", label: "Minerals", key: "minerals" },
  { href: "lava-lamps", label: "Lava Lab", key: "lava", line: "lava" },
  { href: "nails", label: "Taylor's Nails", key: "nails", line: "nails" },
  { href: "journal", label: "Journal", key: "journal" },
  { href: "field-notes", label: "Guides", key: "guides" },
];
---
<header class="site">
  <div class="head">
    <div class="left">
      <span>Grimsley, Tennessee</span>
    </div>
    <a class="wordmark" href={u("")}>
      <div class="name">Grimsley Mineral Co.</div>
      <div class="tag">Minerals · Fossils · Light</div>
    </a>
    <div class="right">
      <a href={u("about")}>About</a>
      <a href={u("contact")} class="cart">
        <svg class="ico" viewBox="0 0 24 24"><path d="M12 21s-7-4.35-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.65-7 10-7 10z"></path></svg>
        Contact
      </a>
    </div>
  </div>
  <nav class="mega">
    <ul>
      {nav.map((n) => (
        <li data-line={n.line || undefined}><a href={u(n.href)} class={active === n.key ? "active" : ""}>{n.label}</a></li>
      ))}
    </ul>
  </nav>
</header>
