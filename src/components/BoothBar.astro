---
// Standing callout for the 127 booth pricing. Hidden by CSS unless <html>
// carries data-booth, so it disappears on its own once the sale is over.
// Percentages come from BOOTH_SALE, never typed into copy.
import { SITE, TIERS, BOOTH_SALE, boothTierLabels, u } from "../consts";

const tiers = boothTierLabels(TIERS);
const excluded = TIERS.filter((t) => !(BOOTH_SALE.discounts[t.key] > 0)).map((t) => t.label);
---
<div class="boothbar">
  <div class="k">At the booth · {SITE.event.dates}</div>
  <h3>Sale pricing for the run of the 127.</h3>
  <div class="tiers">
    {tiers.map((t) => (
      <div><b>{t.pct}% off</b><span class="lbl">{t.label}</span></div>
    ))}
  </div>
  <p>
    {BOOTH_SALE.terms} {excluded.length > 0 && `${excluded.join(" and ")} pieces stay at list and are negotiated in person, the way they always were.`}
    {" "}<a href={u("visit")}>Where to find us</a>.
  </p>
</div>
