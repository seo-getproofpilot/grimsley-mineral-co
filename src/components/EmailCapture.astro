---
// Footer email signup. The whole point of this block is the Highway 127 weekend:
// most people who pick a piece up and put it back are gone forever otherwise.
// Posts to SITE.newsletterEndpoint when one is set; falls back to a pre-filled
// email when it is not, so the form is never a dead end. See subscribe.js.
import { SITE } from "../consts";
---
<div class="signup">
  <h5>First look at new pieces</h5>
  <p>New specimens go out to the list before they hit the site. No more than a couple of emails a month.</p>
  <form class="js-subscribe" data-endpoint={SITE.newsletterEndpoint} data-email={SITE.email}>
    <label class="sr-only" for="signup-email">Email address</label>
    <input
      id="signup-email"
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder="you@example.com"
    />
    <button type="submit">Join the list</button>
  </form>
  <p class="signup-msg" role="status" aria-live="polite"></p>
</div>
